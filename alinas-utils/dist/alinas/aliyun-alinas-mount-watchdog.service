[Unit]
Description=aliyun-alinas-mount-watchdog

[Service]
Type=simple
ExecStart=/usr/bin/env aliyun-alinas-mount-watchdog
ExecStopPost=-/usr/bin/env python3 /opt/aliyun/alinas/process_probe.py kill-exe /usr/local/nas-agent/nas-agent
KillMode=process
KillSignal=SIGKILL
Restart=always
RestartSec=15s
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
